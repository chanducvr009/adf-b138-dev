{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-b138-dev"
		},
		"ls_source_sql_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_source_sql'"
		},
		"ls_source_target_1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_source_target_1'"
		},
		"ls_target_sql_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_target_sql'"
		},
		"ls_source_target_1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsb111dev.dfs.core.windows.net/"
		},
		"Tumbling_window_trigger_properties_pipeline_parameters_startdate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"Tumbling_window_trigger_properties_pipeline_parameters_enddate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"event_trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/bd758504-1d07-435c-923e-a0d2f0f087ff/resourceGroups/rg-adf-b8/providers/Microsoft.Storage/storageAccounts/adlsb111dev"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-b138-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_source_sql_connectionString": {
						"value": "[parameters('ls_source_sql_connectionString')]"
					},
					"ls_source_target_1_accountKey": {
						"value": "[parameters('ls_source_target_1_accountKey')]"
					},
					"ls_target_sql_connectionString": {
						"value": "[parameters('ls_target_sql_connectionString')]"
					},
					"ls_source_target_1_properties_typeProperties_url": {
						"value": "[parameters('ls_source_target_1_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-b138-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Tumbling_window_trigger_properties_pipeline_parameters_startdate": {
						"value": "[parameters('Tumbling_window_trigger_properties_pipeline_parameters_startdate')]"
					},
					"Tumbling_window_trigger_properties_pipeline_parameters_enddate": {
						"value": "[parameters('Tumbling_window_trigger_properties_pipeline_parameters_enddate')]"
					},
					"event_trigger_properties_typeProperties_scope": {
						"value": "[parameters('event_trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-b138-dev_ArmTemplate_0')]"
			]
		}
	]
}